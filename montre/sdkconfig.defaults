CONFIG_IDF_TARGET="esp32s3"

# Même flash, même table et même PSRAM qu'Echoes et le PC DOS (le chargeur de démarrage vient d'ici)
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_CAPS_ALLOC=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# Fluidité comme Echoes écran allumé (240 MHz, code optimisé pour la vitesse, cache de données de 64 Ko à lignes de 64 octets :
# les recopies plein écran en PSRAM en dépendent) ; écran éteint : 40 MHz, fréquence dynamique et veille légère automatique
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_FREERTOS_HZ=100
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# Bluetooth : NimBLE périphérique (le téléphone se connecte), pile en PSRAM, veille du modem
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_MAX_BONDS=3
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=247
CONFIG_BT_NIMBLE_SVC_GAP_DEVICE_NAME="Echoes Montre"
CONFIG_BT_CTRL_MODEM_SLEEP=y
CONFIG_BT_CTRL_MODEM_SLEEP_MODE_1=y
CONFIG_BT_CTRL_LPCLK_SEL_RTC_SLOW=y

# Carte SD soudée (SDMMC 4 bits, broches du connecteur du dos), noms longs
CONFIG_ECHOES_SD_CLK=39
CONFIG_ECHOES_SD_CMD=40
CONFIG_ECHOES_SD_D0=18
CONFIG_ECHOES_SD_D1=17
CONFIG_ECHOES_SD_D2=42
CONFIG_ECHOES_SD_D3=41
CONFIG_ECHOES_SD_RAPIDE=y
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
CONFIG_FATFS_USE_FASTSEEK=y

# Stockage USB (usb.c) : TinyUSB, classe MSC
CONFIG_TINYUSB_MSC_ENABLED=y
